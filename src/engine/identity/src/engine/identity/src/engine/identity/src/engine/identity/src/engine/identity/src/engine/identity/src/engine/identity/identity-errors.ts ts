// Beast System 3.0 — Sovereign Identity Kernel v3
// Module: IdentityErrors
// Purpose: Centralized error definitions, governance-aligned error codes,
// structured error metadata, and uniform error class for all identity subsystems.

export type IdentityErrorCode =
  | "INVALID_WALLET"
  | "INVALID_WALLET_FORMAT"
  | "INVALID_CHECKSUM"
  | "INVALID_DID"
  | "INVALID_DID_FORMAT"
  | "WALLET_ALREADY_BOUND"
  | "IDENTITY_NOT_FOUND"
  | "IDENTITY_NOT_ACTIVE"
  | "MISSING_REQUIRED_METADATA"
  | "PROHIBITED_BADGE_CODE"
  | "PROHIBITED_BADGE_DEFINITION"
  | "UNKNOWN_BADGE_CODE"
  | "BADGE_NOT_FOUND"
  | "REPLAY_ATTACK_DETECTED"
  | "INVALID_NONCE"
  | "ANCHOR_VERIFICATION_FAILED"
  | "ARTIFACT_NOT_FOUND"
  | "UNAUTHORIZED_ACTION"
  | "INTEGRITY_VIOLATION"
  | "GOVERNANCE_CONSTRAINT_FAILURE";

export interface IdentityErrorContext {
  did?: string;
  wallet?: string;
  badgeId?: string;
  code?: string;
  key?: string;
  nonce?: string;
  reason?: string;
  metadata?: Record<string, unknown>;
}

export class IdentityError extends Error {
  readonly code: IdentityErrorCode;
  readonly context?: IdentityErrorContext;
  readonly timestamp: Date;
  readonly governanceVersion: string;
  readonly federalCase: string;

  constructor(
    code: IdentityErrorCode,
    message: string,
    context?: IdentityErrorContext
  ) {
    super(message);

    this.code = code;
    this.context = context;
    this.timestamp = new Date();

    // Embedded governance + federal provenance
    this.governanceVersion = "3.0";
    this.federalCase = "2:25-cv-00484-JPH-MJD";

    Object.setPrototypeOf(this, IdentityError.prototype);
  }

  /**
   * Serialize error for logging, audit, or federal-record anchoring.
   */
  serialize(): Record<string, unknown> {
    return {
      code: this.code,
      message: this.message,
      timestamp: this.timestamp.toISOString(),
      governanceVersion: this.governanceVersion,
      federalCase: this.federalCase,
      context: this.context ?? {},
    };
  }

  /**
   * Export error as JSON string.
   */
  toJSON(): string {
    return JSON.stringify(this.serialize(), null, 2);
  }
}

/**
 * Utility: throw if condition fails.
 */
export function assertIdentity(
  condition: boolean,
  code: IdentityErrorCode,
  message: string,
  context?: IdentityErrorContext
): void {
  if (!condition) {
    throw new IdentityError(code, message, context);
  }
}
